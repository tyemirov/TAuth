id: tauth-console
display_name: TAuth console
tenant_origins: ["${TAUTH_CONSOLE_ORIGIN}"]
google_web_client_id: "${TAUTH_CONSOLE_GOOGLE_CLIENT_ID}"
jwt_signing_key: "${TAUTH_CONSOLE_SESSION_KEY}"
session_cookie_name: tauth_console_session
refresh_cookie_name: tauth_console_refresh
session_ttl: 15m
refresh_ttl: 720h
allow_insecure_http: "${TAUTH_CONSOLE_ALLOW_INSECURE_HTTP}"
account_management:
  enabled: true
  email_delivery:
    server_address: "${TAUTH_CONSOLE_PINGUIN_ADDRESS}"
    api_key: "${TAUTH_CONSOLE_PINGUIN_KEY}"
    connection_timeout_seconds: 3
    operation_timeout_seconds: 5
    email_verification_url: "${TAUTH_CONSOLE_ORIGIN}/app/verify"
    password_reset_url: "${TAUTH_CONSOLE_ORIGIN}/app/reset"
    password_link_url: "${TAUTH_CONSOLE_ORIGIN}/app/link"
